# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native — iOS is generated at build time via expo prebuild / EAS Build
/ios

# Android build artifacts (source code is committed)
/android/build/
/android/app/build/
/android/.gradle/
/android/.cxx/
/android/local.properties

# Keystore & signing (NEVER commit)
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.keystore

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS / IDE
.DS_Store
.idea/
*.pem

# Google OAuth credentials (sensitive — never commit)
*.apps.googleusercontent.com.plist
GoogleService-Info.plist
google-services.json

# local env files
.env*.local

# typescript
*.tsbuildinfo

# Deploy & utility scripts (not part of the app)
_deploy_*.js
_rebuild_apk.ps1
_run_fix.js
task-list.md

# Backend (separate project)
/backend/
